{
  "expo": {
    "owner": "raven.123",
    "name": "Barangay",
    "slug": "Barangay",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./app/assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./app/assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./app/assets/adaptive-icon.png",
        "edgeToEdgeEnabled": true,
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.raven.mobile",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./app/assets/favicon.png"
    },
    "androidStatusBar": {
      "hidden": true,
      "style": "light"
    },
    "androidNavigationBar": {
      "visible": "immersive"
    },
    "plugins": [
      "expo-font",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "1e3aacfa-7cc0-4a17-ac04-81450cb19d32"
      }
    }
  }
}
