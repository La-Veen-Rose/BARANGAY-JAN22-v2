{
  "expo": {
    "owner": "raven.123",
    "name": "RAVEN-Staffs",
    "slug": "raven-staffs",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./app/assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./app/assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.raven.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "jsEngine": "hermes",
      "adaptiveIcon": {
        "foregroundImage": "./app/assets/icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.raven.mobile",
      "googleServicesFile": "google-services.json"
    },
    "web": {
      "favicon": "./app/assets/favicon.png"
    },
    "androidStatusBar": {
      "hidden": true,
      "barStyle": "light-content"
    },
    "androidNavigationBar": {
      "visible": "immersive"
    },
    "plugins": [
      "expo-font",
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "ndkVersion": "26.1.10909125",
            "cmakeVersion": "3.22.1"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "fa390030-2b86-4235-b70d-34a0b253ae39"
      }
    }
  }
}
